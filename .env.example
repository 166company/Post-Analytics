# ─── Meta Graph API Konfiqurasiyası ───────────────────────────────────────────
# Bu faylı .env adı ilə kopyalayın və öz məlumatlarınızı daxil edin.
# XƏBƏRDARLIQ: .env faylını heç vaxt Git-ə commit etməyin!

# Page Access Token (Meta Developer Portal → Graph API Explorer-dən alın)
META_ACCESS_TOKEN=your_page_access_token_here

# Analiz ediləcək səhifə ID-ləri (vergüllə ayırın)
# Səhifə ID-sini tapmaq: facebook.com/sayfaadı → About bölməsi
META_PAGE_IDS=123456789012345,987654321098765

# API versiyası (dəyişdirməyə ehtiyac yoxdur)
META_API_VERSION=v19.0
